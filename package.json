{
  "name": "@lewebsimple/nuxt-graphql",
  "version": "0.7.16",
  "description": "Opinionated Nuxt module for using GraphQL",
  "license": "AGPL-3.0-only",
  "repository": "lewebsimple/nuxt-graphql",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "format": "oxfmt .",
    "lint": "oxlint . --fix",
    "release": "pnpm lint && pnpm test && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "pnpm dev:prepare && vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@graphql-codegen/core": "^6.1.0",
    "@graphql-codegen/typed-document-node": "6.1.6",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.4",
    "@graphql-tools/code-file-loader": "^8.1.32",
    "@graphql-tools/graphql-file-loader": "^8.1.14",
    "@graphql-tools/load": "^8.1.10",
    "@graphql-tools/schema": "^10.0.33",
    "@graphql-tools/stitch": "^10.1.22",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nuxt/kit": "^4.4.8",
    "defu": "^6.1.7",
    "graphql-sse": "^2.6.0",
    "graphql-yoga": "^5.21.2",
    "jiti": "^2.7.0",
    "ohash": "^2.0.11",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/plugin-helpers": "^7.0.1",
    "@lewebsimple/graphql-codegen-zod": "^0.3.3",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "latest",
    "@types/picomatch": "^4.0.3",
    "changelogen": "^0.6.2",
    "graphql": "^16.14.2",
    "nuxt": "^4.4.8",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lewebsimple/graphql-codegen-zod": "^0.3",
    "graphql": "^16",
    "zod": "^4"
  },
  "pnpm": {
    "overrides": {
      "citty": "0.2.1"
    }
  }
}

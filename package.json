{
  "name": "@lewebsimple/nuxt-graphql",
  "version": "0.7.8",
  "description": "Opinionated Nuxt module for using GraphQL",
  "license": "AGPL-3.0-only",
  "repository": "lewebsimple/nuxt-graphql",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "format": "oxfmt .",
    "lint": "oxlint . --fix",
    "release": "pnpm lint && pnpm test && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "pnpm dev:prepare && vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@graphql-codegen/core": "^5.0.2",
    "@graphql-codegen/typed-document-node": "6.1.6",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@graphql-tools/code-file-loader": "^8.1.31",
    "@graphql-tools/graphql-file-loader": "^8.1.13",
    "@graphql-tools/load": "^8.1.9",
    "@graphql-tools/schema": "^10.0.32",
    "@graphql-tools/stitch": "^10.1.18",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nuxt/kit": "^4.4.2",
    "defu": "^6.1.7",
    "es-toolkit": "^1.45.1",
    "graphql-sse": "^2.6.0",
    "graphql-yoga": "^5.21.0",
    "jiti": "^2.6.1",
    "ohash": "^2.0.11",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/plugin-helpers": "^6.3.0",
    "@lewebsimple/graphql-codegen-zod": "^0.2.4",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.2",
    "@types/node": "latest",
    "@types/picomatch": "^4.0.3",
    "changelogen": "^0.6.2",
    "graphql": "^16.13.2",
    "nuxt": "^4.4.2",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.7",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@lewebsimple/graphql-codegen-zod": "^0.2",
    "graphql": "^16",
    "zod": "^4"
  },
  "pnpm": {
    "overrides": {
      "citty": "0.2.1"
    }
  }
}

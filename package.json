{
  "name": "@lewebsimple/nuxt-graphql",
  "version": "0.7.4",
  "description": "Opinionated Nuxt module for using GraphQL",
  "license": "AGPL-3.0-only",
  "repository": "lewebsimple/nuxt-graphql",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "format": "oxfmt .",
    "lint": "oxlint . --fix",
    "release": "pnpm lint && pnpm test && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "pnpm dev:prepare && vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@graphql-codegen/core": "^5.0.1",
    "@graphql-codegen/typed-document-node": "6.1.6",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-tools/code-file-loader": "^8.1.28",
    "@graphql-tools/graphql-file-loader": "^8.1.12",
    "@graphql-tools/load": "^8.1.8",
    "@graphql-tools/schema": "^10.0.31",
    "@graphql-tools/stitch": "^10.1.16",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lewebsimple/graphql-codegen-zod": "^0.2.1",
    "@nuxt/kit": "^4.4.2",
    "defu": "^6.1.4",
    "es-toolkit": "^1.45.1",
    "graphql-sse": "^2.6.0",
    "graphql-yoga": "^5.18.1",
    "jiti": "^2.6.1",
    "ohash": "^2.0.11",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@graphql-codegen/plugin-helpers": "^6.2.0",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "latest",
    "@types/picomatch": "^4.0.2",
    "changelogen": "^0.6.2",
    "graphql": "^16.13.1",
    "nuxt": "^4.4.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "graphql": "^16",
    "zod": "^4"
  },
  "pnpm": {
    "overrides": {
      "citty": "0.2.1"
    }
  }
}
